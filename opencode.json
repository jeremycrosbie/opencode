{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "external_directory": {
      "*": "ask",
      "~/.config/opencode": "allow",
      "~/.config/opencode/**": "allow"
    },
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "wc": "allow",
      "wc *": "allow",
      "tail": "allow",
      "tail *": "allow",
      "cat": "allow",
      "cat *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow"
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "github-copilot/gpt-5.4",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    }
  },
  "model": "ollama/qwen3.6:27b",
  "provider": {
    "ollama": {
      "models": {
        "qwen3-coder-next": {
          "_launch": true,
          "name": "qwen3-coder-next"
        },
        "qwen3.6:27b": {
          "_launch": true,
          "name": "qwen3.6:27b"
        },
        "qwen3.6:27b-mlx-bf16": {
          "_launch": true,
          "name": "qwen3.6:27b-mlx-bf16"
        }
      },
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    }
  }
}
