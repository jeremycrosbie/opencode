{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
		"build": {
			"mode": "primary",
			"model": "github-copilot/gpt-5.4",
			"permission": {
        "edit": "allow",
        "bash": "allow",
				"git log *": "allow",
				"git show *": "allow",
				"ls *": "allow",
				"wc *": "allow",
				"tail *": "allow",
				"cat *": "allow"
      }
		},
    "implementer": {
      "description": "Implements approved feature specifications",
      "mode": "subagent",
      "model": "github-copilot/claude-sonnet-4.6",
      "permission": {
        "bash": "ask",
        "edit": "allow",
        "patch": "allow",
        "write": "allow",
				"git log *": "allow",
				"git show *": "allow",
				"ls *": "allow",
				"wc *": "allow",
				"tail *": "allow",
				"cat *": "allow"
      }
    },
    "orchestrator": {
      "description": "Coordinates planning, implementation, testing, and security review",
      "mode": "primary",
      "model": "github-copilot/claude-sonnet-4.6",
      "options": {
        "effort": "medium"
      },
      "permission": {
        "bash": "ask",
				"git log *": "allow",
				"git show *": "allow",
				"git status *": "allow",
				"git diff *": "allow",
				"ls *": "allow",
				"wc *": "allow",
				"tail *": "allow",
				"cat *": "allow",
        "task": {
          "*": "deny",
          "implementer": "allow",
          "owasp-reviewer": "allow",
          "planner": "allow",
          "pr-reviewer": "allow",
          "test-writer": "allow"
        }
      }
    },
    "owasp-reviewer": {
      "description": "Reviews diffs for OWASP-aligned security issues",
      "mode": "subagent",
      "model": "github-copilot/claude-sonnet-4.6",
      "options": {
        "effort": "high"
      },
      "permission": {
        "bash": "ask",
        "edit": "deny",
        "patch": "deny",
        "write": "deny",
				"git log *": "allow",
				"git show *": "allow",
				"ls *": "allow",
				"wc *": "allow",
				"tail *": "allow",
				"cat *": "allow"
      }
    },
    "planner": {
      "description": "Creates implementation plans without changing the codebase",
      "mode": "primary",
      "model": "github-copilot/claude-opus-4.6",
      "options": {
        "effort": "high"
      },
      "permission": {
        "bash": "ask",
        "edit": "deny",
        "patch": "deny",
        "write": "deny",
				"git log *": "allow",
				"git show *": "allow",
				"ls *": "allow",
				"wc *": "allow",
				"tail *": "allow",
				"cat *": "allow"
      }
    },
    "pr-reviewer": {
      "model": "github-copilot/claude-sonnet-4.6",
      "options": {
        "effort": "high"
      },
      "permission": {
        "bash": "ask",
				"git log *": "allow",
				"git show *": "allow",
				"ls *": "allow",
				"wc *": "allow",
				"tail *": "allow",
				"cat *": "allow",
        "edit": "deny"
      }
    },
    "test-writer": {
      "description": "Adds or updates unit and integration tests",
      "mode": "subagent",
      "model": "github-copilot/gpt-5.4",
      "permission": {
        "bash": "ask",
        "edit": "allow",
        "patch": "allow",
        "write": "allow"
      }
    }
  },
  "model": "ollama/qwen3.6:27b",
  "provider": {
    "ollama": {
      "models": {
        "qwen3-coder-next": {
          "_launch": true,
          "name": "qwen3-coder-next"
        },
        "qwen3.6:27b": {
          "_launch": true,
          "name": "qwen3.6:27b"
        },
        "qwen3.6:27b-mlx-bf16": {
          "_launch": true,
          "name": "qwen3.6:27b-mlx-bf16"
        }
      },
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    }
  }
}
