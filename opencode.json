{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "external_directory": {
      "*": "ask",
      "~/.config/opencode": "allow",
      "~/.config/opencode/**": "allow"
    },
    "bash": {
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "wc": "allow",
      "wc *": "allow",
      "tail": "allow",
      "tail *": "allow",
      "cat": "allow",
      "cat *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "date *": "allow",
      "find *": "allow",
      "head *": "allow",
      "echo *": "allow",
      "which *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "git remote": "allow",
      "git remote *": "allow",
      "git stash list": "allow",
      "git stash list *": "allow",
      "git blame *": "allow",
      "git ls-files": "allow",
      "git ls-files *": "allow",
      "git rev-parse *": "allow",
      "git describe": "allow",
      "git describe *": "allow",
      "git shortlog *": "allow",
      "git tag": "allow",
      "git tag *": "allow",
      "git grep *": "allow",
      "npm list *": "allow",
      "docker logs *": "allow",
      "sdk list *": "allow",
      "env": "allow",
      "printenv *": "allow",
      "sdk env": "allow",
      "docker ps": "allow",
      "docker ps *": "allow",
      "docker-compose *": "allow",
      "*": "ask"
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "github-copilot/gpt-5.4",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    }
  },
  "model": "ollama/qwen3.6:27b",
  "provider": {
    "ollama": {
      "models": {
        "qwen3-coder-next": {
          "_launch": true,
          "name": "qwen3-coder-next"
        },
        "qwen3.6:27b": {
          "_launch": true,
          "name": "qwen3.6:27b"
        },
        "qwen3.6:27b-mlx-bf16": {
          "_launch": true,
          "name": "qwen3.6:27b-mlx-bf16"
        }
      },
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    },
    "mlx-local": {
      "name": "MLX Local Server",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:10800/v1"
      },
      "models": {
				"mlx-community/Qwen3-Coder-30B-A3B-Instruct-bf16": {
					"name": "mlx-community/Qwen3-Coder-30B-A3B-Instruct-bf16"
				},
        "mlx-community/Qwen3.6-27B-8bit": {
          "name": "mlx-community/Qwen3.6-27B-8bit"
        }
      }
		}
  }
}
