{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "external_directory": {
      "*": "ask",
      "~/.config/opencode": "allow",
      "~/.config/opencode/**": "allow"
    },
    "bash": {
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "wc": "allow",
      "wc *": "allow",
      "tail": "allow",
      "tail *": "allow",
      "cat": "allow",
      "cat *": "allow",

      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "git remote": "allow",
      "git remote *": "allow",
      "git stash list": "allow",
      "git stash list *": "allow",
      "git blame *": "allow",
      "git ls-files": "allow",
      "git ls-files *": "allow",
      "git rev-parse *": "allow",
      "git rev-list *": "allow",
      "git describe": "allow",
      "git describe *": "allow",
      "git shortlog *": "allow",
      "git tag": "allow",
      "git tag *": "allow",
      "git grep *": "allow",
      "git fetch": "allow",
      "git fetch *": "allow",
      "git config --get *": "allow",
      "git config --list *": "allow",
      "git cat-file *": "allow",
      "git ls-tree *": "allow",
      "git merge-base *": "allow",
      "git for-each-ref *": "allow",
      "git check-ignore *": "allow",
      "git worktree list": "allow",
      "git worktree list *": "allow",

      "date *": "allow",
      "find *": "allow",
      "head *": "allow",
      "echo *": "allow",
      "which *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "type *": "allow",
      "test *": "allow",
      "[ *": "allow",
      "true": "allow",
      "false": "allow",

      "npm list *": "allow",
      "npm run *": "allow",
      "npm test": "allow",
      "npm test *": "allow",
      "npx *": "allow",
      "node *": "allow",
      "yarn *": "allow",
      "pnpm *": "allow",

      "python *": "allow",
      "python3 *": "allow",
      "uv run *": "allow",
      "uv *": "allow",
      "poetry run *": "allow",
      "pip list *": "allow",
      "pip show *": "allow",
      "ruff *": "allow",
      "mypy *": "allow",
      "pytest *": "allow",

      "docker logs *": "allow",
      "docker ps": "allow",
      "docker ps *": "allow",
      "docker inspect *": "allow",
      "docker images *": "allow",
      "docker-compose *": "allow",

      "sdk list *": "allow",
      "sdk env": "allow",
      "env": "allow",
      "printenv *": "allow",
      "open *": "allow",
      "curl *": "allow",
      "jq *": "allow",

      "*": "ask"
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "github-copilot/gpt-5.4",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    }
  },
  "model": "ollama/qwen3.6:27b",
  "mcp": {
    "time-reaper": {
      "type": "local",
      "command": ["{env:HOME}/.local/bin/time-reaper"],
      "enabled": true,
      "environment": {
        "HARVEST_TOKEN": "{env:HARVEST_TOKEN}",
        "HARVEST_ACCOUNT_ID": "{env:HARVEST_ACCOUNT_ID}"
      }
    },
    "shortcut": {
      "type": "local",
      "command": ["{env:HOME}/.local/bin/story-proxy-mcp"],
      "enabled": true,
      "environment": {
        "SHORTCUT_TOKEN_LEFTLANEWHEELHOUSE": "{env:SHORTCUT_TOKEN_LEFTLANEWHEELHOUSE}",
        "SHORTCUT_TOKEN_CPLINVOICINGPAYMENTSPROJECT": "{env:SHORTCUT_TOKEN_CPLINVOICINGPAYMENTSPROJECT}"
      }
    }
  },
  "provider": {
		"anthropic": {
			"options": {
				"apiKey": "{env:ANTHROPIC_OPENCODE_KEY}"
			},
			"whitelist": [
				"claude-opus-5",
				"claude-sonnet-5",
				"claude-opus-4-8",
				"claude-fable-5"
			]
		},
		"openai": {
			"options": {
				"apiKey": "{env:OPENAI_OPENCODE_KEY}"
			},
			"whitelist": [
				"gpt-5.6-sol",
				"gpt-5.6-terra",
				"gpt-5.6-luna"
			]
		},
    "ollama": {
      "models": {
        "qwen3-coder-next": {
          "_launch": true,
          "name": "qwen3-coder-next"
        },
        "qwen3.6:27b": {
          "_launch": true,
          "name": "qwen3.6:27b"
        },
        "qwen3.6:27b-mlx-bf16": {
          "_launch": true,
          "name": "qwen3.6:27b-mlx-bf16"
        }
      },
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    },
    "mlx-local": {
      "name": "MLX Local Server",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:10800/v1"
      },
      "models": {
				"mlx-community/Qwen3-Coder-30B-A3B-Instruct-bf16": {
					"name": "mlx-community/Qwen3-Coder-30B-A3B-Instruct-bf16"
				},
        "mlx-community/Qwen3.6-27B-8bit": {
          "name": "mlx-community/Qwen3.6-27B-8bit"
        }
      }
		}
  }
}
